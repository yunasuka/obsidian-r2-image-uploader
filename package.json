{
  "name": "r2-image-uploader",
  "version": "0.1.0",
  "description": "Paste or drop images into Obsidian and upload them to Cloudflare R2 automatically.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "vitest run",
    "install-vault": "node scripts/install-vault.mjs"
  },
  "keywords": ["obsidian", "cloudflare", "r2", "image", "upload"],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "obsidian": "1.14.4",
    "tslib": "^2.8.1",
    "typescript": "^5.6.0",
    "vitest": "^3.2.0"
  }
}
